# backend/.env.example
# Copy this to backend/.env and fill in your values

# ── PostgreSQL on D: drive ────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/martial_arts_db

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Groq LLM (get free key at console.groq.com) ──────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
