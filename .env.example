# ── Docker Compose environment variables ──────────────────────────────────────
# Copy this file to .env (same directory — project root) and fill in values.
# docker-compose.yml reads from .env automatically.
# NEVER commit .env to git — it contains real passwords.
# =============================================================================

# PostgreSQL password
# Docker Compose creates the PostgreSQL database using this password.
# Pick anything strong. The backend connects using this same value.
DB_PASSWORD=YourStrongPasswordHere

# JWT secret key
# Used to sign authentication tokens. Generate a long random string.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret-key

# JWT token expiry (minutes). 1440 = 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq API Key
# Get a FREE key at: https://console.groq.com
# Used by the AI coaching (RAG) pipeline to call Llama-3.3-70b.
# If left empty the app still works — it uses the built-in rule-based fallback.
GROQ_API_KEY=gsk_your_key_here
