# =============================================================================
# frontend/Dockerfile
# =============================================================================
#
# Multi-stage build:
#   Stage 1 "builder" — installs npm deps, runs `next build` (produces .next/)
#   Stage 2 "runtime" — copies only the standalone output (~30 MB vs ~600 MB)
#
# WHY multi-stage?
#   `npm ci` + `next build` pulls in hundreds of MB of devDependencies
#   (TypeScript compiler, webpack, etc.) that are NOT needed at runtime.
#   The standalone output is a self-contained Node.js app that doesn't need
#   node_modules at all.
#
# WHY node:20-alpine?
#   alpine = minimal Linux base (~5 MB).  node:20 = Node 20 LTS (stable).
# =============================================================================

# ── Stage 1: Builder ─────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files FIRST (Docker layer caching).
# If package.json and package-lock.json don't change, `npm ci` is skipped.
COPY package.json package-lock.json* ./

# npm ci = clean install from lock file (reproducible, faster than npm install)
RUN npm ci

# Copy all source files
COPY . .

# Build Next.js for production.
# `next build` compiles pages, optimises assets, generates .next/standalone/
# because we added `output: 'standalone'` in next.config.mjs
ENV NODE_ENV=production
RUN npm run build


# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production

# next build with output:'standalone' produces a self-contained server at:
#   .next/standalone/server.js
# It includes a minimal node_modules copy — only what's needed at runtime.
COPY --from=builder /app/.next/standalone ./

# Static assets (CSS, JS chunks, images) are NOT included in standalone.
# They must be copied separately into the exact path Next.js expects.
COPY --from=builder /app/.next/static ./.next/static

# Public folder (favicon, images, etc.)
COPY --from=builder /app/public ./public

EXPOSE 3000

# `server.js` is the entry point generated by Next.js standalone mode.
# It is a plain Node.js HTTP server — no next CLI needed.
CMD ["node", "server.js"]
